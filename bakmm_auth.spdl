hashfunction h;
const xor: Function;

protocol BAKMMIoD(DE, ES)
{

    role DE
    {
        fresh rs1: Nonce;

        const TIDDEi, TIDnDEi, RIDDEi, RIDESj,
              TCDEi, TCESj, MSDEiESj,
              T1, T2, T3, rs1, rs2;

        var rs2: Nonce;

        macro M1 =
            xor(
                h(RIDDEi, MSDEiESj, T1),
                h(TCDEi, rs1, MSDEiESj, T1)
            );

        macro M2 =
            h(
                h(TCDEi, rs1, MSDEiESj, T1),
                RIDDEi,
                T1
            );

        macro SKDEiESj =
            h(
                h(TCDEi, rs1, MSDEiESj, T1),
                h(RIDESj, TCESj, rs2, MSDEiESj, T2),
                T1, T2,
                RIDDEi,
                MSDEiESj
            );

        macro M4 =
            h(SKDEiESj, T1, T2, RIDDEi);

        macro M5 =
            xor(
                TIDnDEi,
                h(
                    h(TCDEi, rs1, MSDEiESj, T1),
                    RIDDEi,
                    T2
                )
            );

        macro M6 =
            h(SKDEiESj, T3);


        send_1(DE, ES,
            TIDDEi, M1, M2, T1
        );

        recv_2(ES, DE,
            xor(
                h(RIDDEi, MSDEiESj, T2),
                h(RIDESj, TCESj, rs2, MSDEiESj, T2)
            ),
            M4,
            M5,
            T2
        );

        send_3(DE, ES,
            M6, T3
        );


        claim_DE1(DE, Secret, rs1);
        claim_DE2(DE, Secret, TCDEi);
        claim_DE3(DE, Secret, MSDEiESj);

        claim_DE4(DE, Niagree);
        claim_DE5(DE, Nisynch);

        claim_DE6(DE, Secret, SKDEiESj);

        claim_DE7(DE, Weakagree);
        claim_DE8(DE, Alive);
    }


    role ES
    {
        fresh rs2: Nonce;

        const TIDDEi, TIDnDEi, RIDDEi, RIDESj,
              TCDEi, TCESj, MSDEiESj,
              T1, T2, T3, rs1, rs2;

        var rs1: Nonce;

        macro M3 =
            xor(
                h(RIDDEi, MSDEiESj, T2),
                h(RIDESj, TCESj, rs2, MSDEiESj, T2)
            );

        macro SKESjDEi =
            h(
                h(TCDEi, rs1, MSDEiESj, T1),
                h(RIDESj, TCESj, rs2, MSDEiESj, T2),
                T1, T2,
                RIDDEi,
                MSDEiESj
            );

        macro M4 =
            h(SKESjDEi, T1, T2, RIDDEi);

        macro M5 =
            xor(
                TIDnDEi,
                h(
                    h(TCDEi, rs1, MSDEiESj, T1),
                    RIDDEi,
                    T2
                )
            );

        macro M6 =
            h(SKESjDEi, T3);


        recv_1(DE, ES,
            TIDDEi, M1, M2, T1
        );

        send_2(ES, DE,
            M3,
            M4,
            M5,
            T2
        );

        recv_3(DE, ES,
            M6,
            T3
        );


        claim_ES1(ES, Secret, rs2);
        claim_ES2(ES, Secret, TCESj);
        claim_ES3(ES, Secret, MSDEiESj);

        claim_ES4(ES, Niagree);
        claim_ES5(ES, Nisynch);

        claim_ES6(ES, Secret, SKESjDEi);

        claim_ES7(ES, Weakagree);
        claim_ES8(ES, Alive);
    }
}
