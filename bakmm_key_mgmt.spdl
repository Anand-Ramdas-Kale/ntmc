/*
 * BAKMM-IoD
 *
 * Key Management Phase
 *
 * ES <-> CS
 *
 * Based on Section 4.3 of the paper.
 */

hashfunction h;
const xor: Function;


/*
 * Long-term secret parameters
 */

secret RIDESj;
secret RIDCSk;

secret TCESj;
secret TCCSk;

secret MSESjCSk;

secret TINESj;


/*
 * Protocol
 */

protocol BAKMMKeyManagement(ES, CS)
{

    /*
     * ============================================================
     * ES ROLE
     * ============================================================
     */

    role ES
    {

        /*
         * Fresh values generated by ES
         */

        fresh RS1: Nonce;
        fresh TS1: Nonce;
        fresh TS3: Nonce;


        /*
         * Values received from CS
         */

        var RS2: Nonce;
        var TS2: Nonce;

        var m3;
        var m4;
        var m5;


        /*
         * --------------------------------------------------------
         * m1
         * --------------------------------------------------------
         */

        macro m1 =
            xor(
                h(TCESj, RS1, MSESjCSk, TS1),
                h(RIDESj, MSESjCSk, TS1)
            );


        /*
         * --------------------------------------------------------
         * m2
         * --------------------------------------------------------
         */

        macro m2 =
            h(
                h(RS1, TCESj, MSESjCSk, TS1),
                RIDESj,
                MSESjCSk,
                TS1
            );


        /*
         * --------------------------------------------------------
         * Session key
         * --------------------------------------------------------
         */

        macro SKESjCSk =
            h(
                h(RS2, TCCSk, MSESjCSk, TS2),
                h(RS1, TCESj, MSESjCSk, TS1),
                RIDESj,
                MSESjCSk,
                TS1,
                TS2
            );


        /*
         * --------------------------------------------------------
         * m4
         * --------------------------------------------------------
         */

        macro m4 =
            h(
                SKESjCSk,
                RIDESj,
                MSESjCSk,
                TS2
            );


        /*
         * --------------------------------------------------------
         * m6
         * --------------------------------------------------------
         */

        macro m6 =
            h(
                SKESjCSk,
                TS3
            );


        /*
         * ========================================================
         * MESSAGE 1
         * ========================================================
         */

        send_1(
            ES,
            CS,
            TINESj,
            m1,
            m2,
            TS1
        );


        /*
         * ========================================================
         * MESSAGE 2
         * ========================================================
         */

        recv_2(
            CS,
            ES,
            m3,
            m4,
            m5,
            TS2
        );


        /*
         * ========================================================
         * MESSAGE 3
         * ========================================================
         */

        send_3(
            ES,
            CS,
            m6,
            TS3
        );


        /*
         * ========================================================
         * SECURITY CLAIMS
         * ========================================================
         */

        claim_ES1(ES, Secret, RS1);
        claim_ES2(ES, Secret, MSESjCSk);
        claim_ES3(ES, Secret, SKESjCSk);

        claim_ES4(ES, Niagree);
        claim_ES5(ES, Nisynch);
        claim_ES6(ES, Weakagree);
        claim_ES7(ES, Alive);
    }


    /*
     * ============================================================
     * CS ROLE
     * ============================================================
     */

    role CS
    {

        /*
         * Fresh values generated by CS
         */

        fresh RS2: Nonce;
        fresh TS2: Nonce;
        fresh TINnew: Nonce;


        /*
         * Values received from ES
         */

        var RS1: Nonce;
        var TS1: Nonce;

        var m1;
        var m2;
        var TS3: Nonce;


        /*
         * --------------------------------------------------------
         * m3
         * --------------------------------------------------------
         */

        macro m3 =
            xor(
                h(RS2, TCCSk, MSESjCSk, TS2),
                h(RIDESj, MSESjCSk, TS1, TS2)
            );


        /*
         * --------------------------------------------------------
         * Session key
         * --------------------------------------------------------
         */

        macro SKCSkESj =
            h(
                h(RS2, TCCSk, MSESjCSk, TS2),
                h(RS1, TCESj, MSESjCSk, TS1),
                RIDESj,
                MSESjCSk,
                TS1,
                TS2
            );


        /*
         * --------------------------------------------------------
         * m4
         * --------------------------------------------------------
         */

        macro m4 =
            h(
                SKCSkESj,
                RIDESj,
                MSESjCSk,
                TS2
            );


        /*
         * --------------------------------------------------------
         * m5
         * --------------------------------------------------------
         */

        macro m5 =
            xor(
                TINnew,
                h(
                    RIDESj,
                    h(RS1, TCESj, MSESjCSk, TS1),
                    TS2
                )
            );


        /*
         * --------------------------------------------------------
         * m6
         * --------------------------------------------------------
         */

        macro m6 =
            h(
                SKCSkESj,
                TS3
            );


        /*
         * ========================================================
         * MESSAGE 1
         * ========================================================
         */

        recv_1(
            ES,
            CS,
            TINESj,
            m1,
            m2,
            TS1
        );


        /*
         * ========================================================
         * MESSAGE 2
         * ========================================================
         */

        send_2(
            CS,
            ES,
            m3,
            m4,
            m5,
            TS2
        );


        /*
         * ========================================================
         * MESSAGE 3
         * ========================================================
         */

        recv_3(
            ES,
            CS,
            m6,
            TS3
        );


        /*
         * ========================================================
         * SECURITY CLAIMS
         * ========================================================
         */

        claim_CS1(CS, Secret, RS2);
        claim_CS2(CS, Secret, MSESjCSk);
        claim_CS3(CS, Secret, SKCSkESj);

        claim_CS4(CS, Niagree);
        claim_CS5(CS, Nisynch);
        claim_CS6(CS, Weakagree);
        claim_CS7(CS, Alive);
    }
}
